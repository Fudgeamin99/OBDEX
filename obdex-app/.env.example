# Copy to .env and fill in. Without these the app runs on demo data.
PORT=3000

# DVSA MOT History API: apply at https://documentation.history.mot.api.gov.uk/
# DVSA emails you all four values once your application is approved.
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_API_KEY=
MOT_TOKEN_URL=
# MOT_SCOPE=https://tut.mot.api.gov.uk/.default

# DVLA Vehicle Enquiry Service (tax status, tax due date, vehicle details).
# Free key from https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=

# HPI-style history checks: "demo" until you pick a paid provider.
HPI_PROVIDER=demo
# For HPI_PROVIDER=http, set these and map the response in lib/hpi.js (toObdex)
# HPI_API_URL=
# HPI_API_KEY=
# HPI_KEY_HEADER=x-api-key
# HPI_REG_PARAM=vrm
